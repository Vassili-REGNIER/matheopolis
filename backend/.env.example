# Backend-only deploy (AlwaysData server).
# For local development, use the repository root .env instead (copy from .env.example).
#
# This flat format is used when only the backend/ folder is deployed.
# Docker Compose injects variables directly and does not need this file.

APP_ENV=prod
APP_DEBUG=false
APP_MAINTENANCE=false
APP_URL=https://matheopolis.alwaysdata.net
APP_PATH=/
APP_FRONTEND_ORIGIN=https://matheopolis.alwaysdata.net

DB_HOST=mysql-matheopolis.alwaysdata.net
DB_PORT=3306
DB_NAME=matheopolis_prod
DB_USER=matheopolis_prod
DB_PASS=

USER_COOKIE=user_id
USER_FLASH_KEY=flash_messages
USER_CSRF_KEY=csrf_token
SESSION_IDLE_TIMEOUT=1800
SESSION_COOKIE_SAMESITE=Lax
