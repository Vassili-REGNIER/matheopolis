# Used by the Docker backend container (Apache document root = backend/public).
# Not used on AlwaysData hosting — the API is routed via frontend/public/api/index.php.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si le fichier ou dossier existe, on le sert directement
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Sinon, tout va vers index.php
  RewriteRule ^ index.php [L]
</IfModule>
