includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 10

    phpVersion: 80300

    paths:
        - bootstrap
        - config
        - src
        - public

    excludePaths:
        - vendor/*
        # Raw PHP templates: mixed HTML/PHP, not analysed like application classes
        - src/Infrastructure/Resources/templates/*

    treatPhpDocTypesAsCertain: true
