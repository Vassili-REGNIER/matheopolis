Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # API → bootstrap inside the site root (AlwaysData runs PHP only under frontend/public/).
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

    # SPA: serve existing assets, otherwise index.html.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
