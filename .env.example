# Matheopolis environment (copy to .env at repository root)
# Never commit .env — it contains secrets.

# -----------------------------------------------------------------------------
# Local Docker DEV stack (./scripts/dev-up.sh)
# Uses AlwaysData TEST database by default. Set USE_LOCAL_MYSQL=1 for local DB.
# -----------------------------------------------------------------------------

USE_LOCAL_MYSQL=0

DEV_BACKEND_PORT=8080
DEV_FRONTEND_PORT=5173
DEV_APP_URL=http://localhost:8080
DEV_APP_FRONTEND_ORIGIN=http://localhost:5173
DEV_APP_ENV=dev
DEV_APP_DEBUG=true
DEV_PLAY_TOKEN_SECRET=change-me-dev-play-token-secret

# AlwaysData TEST database (remote)
DEV_DB_HOST=mysql-youraccount.alwaysdata.net
DEV_DB_PORT=3306
DEV_DB_NAME=your_test_database
DEV_DB_USER=your_test_user
DEV_DB_PASS=your_test_password

# Optional local MySQL container (only when USE_LOCAL_MYSQL=1)
LOCAL_MYSQL_PORT=3307
LOCAL_DB_NAME=matheopolis
LOCAL_DB_USER=matheopolis
LOCAL_DB_PASS=matheopolis
LOCAL_MYSQL_ROOT_PASSWORD=root

# -----------------------------------------------------------------------------
# Local Docker PROD-like stack (./scripts/prod-up.sh)
# Uses AlwaysData PRODUCTION database — use with care.
# -----------------------------------------------------------------------------

PROD_APP_URL=http://localhost:8081
PROD_APP_FRONTEND_ORIGIN=http://localhost:8081
PROD_FRONTEND_PORT=8081
PROD_APP_ENV=prod
PROD_APP_DEBUG=false
PROD_PLAY_TOKEN_SECRET=change-me-long-random-production-secret

PROD_DB_HOST=mysql-youraccount.alwaysdata.net
PROD_DB_PORT=3306
PROD_DB_NAME=your_prod_database
PROD_DB_USER=your_prod_user
PROD_DB_PASS=your_prod_password

PROD_SESSION_IDLE_TIMEOUT=1800
PROD_SESSION_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# AlwaysData SSH deploy (./scripts/deploy-alwaysdata.sh)
# -----------------------------------------------------------------------------

# DEPLOY_HOST=ssh-youraccount.alwaysdata.net
# DEPLOY_USER=youraccount
# DEPLOY_PATH=/home/youraccount/matheopolis
