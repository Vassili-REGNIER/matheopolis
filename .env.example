# Matheopolis environment (copy to .env at repository root)
# Fill in DEV_DB_PASS and PROD_DB_PASS locally — passwords are not stored in Git.

# -----------------------------------------------------------------------------
# DEV — local Docker stack (./scripts/stack/dev-up.sh)
# Uses AlwaysData TEST database by default. Set USE_LOCAL_MYSQL=1 for local DB.
# -----------------------------------------------------------------------------

USE_LOCAL_MYSQL=0

DEV_BACKEND_PORT=8080
DEV_FRONTEND_PORT=5173
DEV_APP_URL=http://localhost:8080
DEV_APP_FRONTEND_ORIGIN=http://localhost:5173
DEV_APP_ENV=dev
DEV_APP_DEBUG=true
# AlwaysData shared dev database (remote)
DEV_DB_HOST=mysql-matheopolis.alwaysdata.net
DEV_DB_PORT=3306
DEV_DB_NAME=matheopolis_dev
DEV_DB_USER=matheopolis_dev
DEV_DB_PASS=

# Optional local MySQL container (only when USE_LOCAL_MYSQL=1)
LOCAL_MYSQL_PORT=3307
LOCAL_DB_NAME=matheopolis
LOCAL_DB_USER=matheopolis
LOCAL_DB_PASS=matheopolis
LOCAL_MYSQL_ROOT_PASSWORD=root

# -----------------------------------------------------------------------------
# PROD — local PROD-like Docker stack (./scripts/stack/prod-up.sh)
# Uses AlwaysData PRODUCTION database — use with care.
# -----------------------------------------------------------------------------

PROD_APP_URL=http://localhost:8081
PROD_APP_FRONTEND_ORIGIN=http://localhost:8081
PROD_FRONTEND_PORT=8081
PROD_APP_ENV=prod
PROD_APP_DEBUG=false
PROD_DB_HOST=mysql-matheopolis.alwaysdata.net
PROD_DB_PORT=3306
PROD_DB_NAME=matheopolis_prod
PROD_DB_USER=matheopolis_prod
PROD_DB_PASS=

PROD_SESSION_IDLE_TIMEOUT=1800
PROD_SESSION_COOKIE_SAMESITE=Lax
PROD_USER_COOKIE=user_id
PROD_USER_FLASH_KEY=flash_messages
PROD_USER_CSRF_KEY=csrf_token

# -----------------------------------------------------------------------------
# TEST — PHPUnit only (./scripts/test/run-backend.sh)
# Always use an isolated local database — never point at dev/prod shared DBs.
# -----------------------------------------------------------------------------

TEST_APP_ENV=test
TEST_APP_DEBUG=true
TEST_APP_URL=http://127.0.0.1:8080
TEST_APP_PATH=/
TEST_APP_FRONTEND_ORIGIN=http://127.0.0.1:5173
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASS=root
TEST_DB_NAME=matheopolis_test
TEST_API_BASE_URL=http://127.0.0.1:8080
TEST_USER_COOKIE=user_id
TEST_USER_FLASH_KEY=flash_messages
TEST_USER_CSRF_KEY=csrf_token
TEST_SESSION_IDLE_TIMEOUT=1800
TEST_SESSION_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# Database seed scripts (./scripts/db/apply.sh, rebuild.sh)
# 1 = load demo accounts + sample data (default); 0 = production content only
# -----------------------------------------------------------------------------

MATHEOPOLIS_INCLUDE_DEMO=1

# -----------------------------------------------------------------------------
# Outbound mail (verification + password reset)
# Dev stack includes Mailpit (SMTP :1025 inside Docker, UI on host — see MAILPIT_UI_PORT).
# Leave DEV_MAIL_SMTP_HOST empty to log messages to backend/logs/app.log instead.
# -----------------------------------------------------------------------------

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DEV_MAIL_SMTP_HOST=mailpit
DEV_MAIL_SMTP_PORT=1025
DEV_MAIL_SMTP_ENCRYPTION=none
DEV_MAIL_SMTP_USER=
DEV_MAIL_SMTP_PASS=
DEV_MAIL_FROM_ADDRESS=noreply@matheopolis.local
DEV_MAIL_FROM_NAME=Matheopolis

PROD_MAIL_SMTP_HOST=
PROD_MAIL_SMTP_PORT=465
PROD_MAIL_SMTP_ENCRYPTION=ssl
PROD_MAIL_SMTP_USER=
PROD_MAIL_SMTP_PASS=
PROD_MAIL_FROM_ADDRESS=matheopolis@alwaysdata.net
PROD_MAIL_FROM_NAME=Matheopolis

# -----------------------------------------------------------------------------
# AlwaysData SSH deploy (./scripts/deploy/alwaysdata.sh)
# -----------------------------------------------------------------------------

DEPLOY_HOST=ssh-matheopolis.alwaysdata.net
DEPLOY_USER=matheopolis
DEPLOY_PATH=/home/matheopolis
